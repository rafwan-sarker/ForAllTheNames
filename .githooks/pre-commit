#!/bin/bash
# Runs the project's definition of done before every commit. Skip once: SKIP_VERIFY=1 git commit ...
[ -n "${SKIP_VERIFY:-}" ] && exit 0
root="$(git rev-parse --show-toplevel)"
[ -x "$root/scripts/verify.sh" ] || exit 0
if ! out=$(bash "$root/scripts/verify.sh" 2>&1); then
  printf '%s\n\ncommit refused: scripts/verify.sh failed (SKIP_VERIFY=1 to override once)\n' "$out" | tail -30 >&2
  exit 1
fi
